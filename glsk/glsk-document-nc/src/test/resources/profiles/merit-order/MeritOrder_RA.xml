<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:nc="http://entsoe.eu/ns/nc#"
         xmlns:md="http://iec.ch/TC57/61970-552/ModelDescription/1#"
         xmlns:dcat="http://www.w3.org/ns/dcat#"
         xmlns:cim="http://iec.ch/TC57/CIM100#"
         xmlns:dcterms="http://purl.org/dc/terms/#">
  <md:FullModel rdf:about="urn:uuid:d4f2b5e3-0000-4000-8000-000000000101">
    <dcterms:creator>http://energy.referencedata.eu/EIC/10XES-REE------E</dcterms:creator>
    <dcterms:conformsTo>http://entsoe.eu/ns/CIM/RemedialAction-EU/2.2</dcterms:conformsTo>
    <dcat:startDate>2029-08-12T00:00:00Z</dcat:startDate>
    <dcat:endDate>2029-08-13T00:00:00Z</dcat:endDate>
    <dcat:keyword>RA</dcat:keyword>
  </md:FullModel>
  <!-- Upward bids are sorted by ascending price: positions 1 to 3 -->
  <nc:CountertradeRemedialAction rdf:ID="_mo-sorted-up">
    <cim:IdentifiedObject.mRID>mo-sorted-up</cim:IdentifiedObject.mRID>
    <nc:RemedialAction.kind rdf:resource="http://entsoe.eu/ns/nc#RemedialActionKind.preventive"/>
    <nc:RemedialAction.normalAvailable>true</nc:RemedialAction.normalAvailable>
    <nc:PowerRemedialAction.BiddingZone rdf:resource="http://energy.referencedata.eu/EIC/zone-mo-sorted-up"/>
    <nc:CountertradeRemedialAction.gLSKStrategy rdf:resource="http://entsoe.eu/ns/nc#GLSKStrategyKind.explicitSchedule"/>
    <nc:CountertradeRemedialAction.shiftMethod rdf:resource="http://entsoe.eu/ns/nc#ShiftMethodKind.priority"/>
  </nc:CountertradeRemedialAction>
  <!-- Downward bids are sorted by ascending price: positions -1 and -2 -->
  <nc:CountertradeRemedialAction rdf:ID="_mo-sorted-down">
    <cim:IdentifiedObject.mRID>mo-sorted-down</cim:IdentifiedObject.mRID>
    <nc:RemedialAction.kind rdf:resource="http://entsoe.eu/ns/nc#RemedialActionKind.preventive"/>
    <nc:RemedialAction.normalAvailable>true</nc:RemedialAction.normalAvailable>
    <nc:PowerRemedialAction.BiddingZone rdf:resource="http://energy.referencedata.eu/EIC/zone-mo-sorted-down"/>
    <nc:CountertradeRemedialAction.gLSKStrategy rdf:resource="http://entsoe.eu/ns/nc#GLSKStrategyKind.explicitSchedule"/>
    <nc:CountertradeRemedialAction.shiftMethod rdf:resource="http://entsoe.eu/ns/nc#ShiftMethodKind.priority"/>
  </nc:CountertradeRemedialAction>
  <!-- Upward and downward bids make independent stacks -->
  <nc:CountertradeRemedialAction rdf:ID="_mo-up-down">
    <cim:IdentifiedObject.mRID>mo-up-down</cim:IdentifiedObject.mRID>
    <nc:RemedialAction.kind rdf:resource="http://entsoe.eu/ns/nc#RemedialActionKind.preventive"/>
    <nc:RemedialAction.normalAvailable>true</nc:RemedialAction.normalAvailable>
    <nc:PowerRemedialAction.BiddingZone rdf:resource="http://energy.referencedata.eu/EIC/zone-mo-up-down"/>
    <nc:CountertradeRemedialAction.gLSKStrategy rdf:resource="http://entsoe.eu/ns/nc#GLSKStrategyKind.explicitSchedule"/>
    <nc:CountertradeRemedialAction.shiftMethod rdf:resource="http://entsoe.eu/ns/nc#ShiftMethodKind.priority"/>
  </nc:CountertradeRemedialAction>
  <!-- Bids with the same price are ordered by bid, to be deterministic -->
  <nc:CountertradeRemedialAction rdf:ID="_mo-equal-prices">
    <cim:IdentifiedObject.mRID>mo-equal-prices</cim:IdentifiedObject.mRID>
    <nc:RemedialAction.kind rdf:resource="http://entsoe.eu/ns/nc#RemedialActionKind.preventive"/>
    <nc:RemedialAction.normalAvailable>true</nc:RemedialAction.normalAvailable>
    <nc:PowerRemedialAction.BiddingZone rdf:resource="http://energy.referencedata.eu/EIC/zone-mo-equal-prices"/>
    <nc:CountertradeRemedialAction.gLSKStrategy rdf:resource="http://entsoe.eu/ns/nc#GLSKStrategyKind.explicitSchedule"/>
    <nc:CountertradeRemedialAction.shiftMethod rdf:resource="http://entsoe.eu/ns/nc#ShiftMethodKind.priority"/>
  </nc:CountertradeRemedialAction>
  <!-- The bid b has a new price and a new power at noon: the merit order changes -->
  <nc:CountertradeRemedialAction rdf:ID="_mo-time-series">
    <cim:IdentifiedObject.mRID>mo-time-series</cim:IdentifiedObject.mRID>
    <nc:RemedialAction.kind rdf:resource="http://entsoe.eu/ns/nc#RemedialActionKind.preventive"/>
    <nc:RemedialAction.normalAvailable>true</nc:RemedialAction.normalAvailable>
    <nc:PowerRemedialAction.BiddingZone rdf:resource="http://energy.referencedata.eu/EIC/zone-mo-time-series"/>
    <nc:CountertradeRemedialAction.gLSKStrategy rdf:resource="http://entsoe.eu/ns/nc#GLSKStrategyKind.explicitSchedule"/>
    <nc:CountertradeRemedialAction.shiftMethod rdf:resource="http://entsoe.eu/ns/nc#ShiftMethodKind.priority"/>
  </nc:CountertradeRemedialAction>
  <!-- The bid b has no price and power before noon: it contributes nothing before -->
  <nc:CountertradeRemedialAction rdf:ID="_mo-bid-starts-later">
    <cim:IdentifiedObject.mRID>mo-bid-starts-later</cim:IdentifiedObject.mRID>
    <nc:RemedialAction.kind rdf:resource="http://entsoe.eu/ns/nc#RemedialActionKind.preventive"/>
    <nc:RemedialAction.normalAvailable>true</nc:RemedialAction.normalAvailable>
    <nc:PowerRemedialAction.BiddingZone rdf:resource="http://energy.referencedata.eu/EIC/zone-mo-bid-starts-later"/>
    <nc:CountertradeRemedialAction.gLSKStrategy rdf:resource="http://entsoe.eu/ns/nc#GLSKStrategyKind.explicitSchedule"/>
    <nc:CountertradeRemedialAction.shiftMethod rdf:resource="http://entsoe.eu/ns/nc#ShiftMethodKind.priority"/>
  </nc:CountertradeRemedialAction>
  <!-- No bid has a price and power before noon: there is no merit order before -->
  <nc:CountertradeRemedialAction rdf:ID="_mo-first-point-at-noon">
    <cim:IdentifiedObject.mRID>mo-first-point-at-noon</cim:IdentifiedObject.mRID>
    <nc:RemedialAction.kind rdf:resource="http://entsoe.eu/ns/nc#RemedialActionKind.preventive"/>
    <nc:RemedialAction.normalAvailable>true</nc:RemedialAction.normalAvailable>
    <nc:PowerRemedialAction.BiddingZone rdf:resource="http://energy.referencedata.eu/EIC/zone-mo-first-point-at-noon"/>
    <nc:CountertradeRemedialAction.gLSKStrategy rdf:resource="http://entsoe.eu/ns/nc#GLSKStrategyKind.explicitSchedule"/>
    <nc:CountertradeRemedialAction.shiftMethod rdf:resource="http://entsoe.eu/ns/nc#ShiftMethodKind.priority"/>
  </nc:CountertradeRemedialAction>
  <!-- The time point of the bid b at noon has no price: it is ignored, so b contributes nothing from noon -->
  <nc:CountertradeRemedialAction rdf:ID="_mo-incomplete-time-point">
    <cim:IdentifiedObject.mRID>mo-incomplete-time-point</cim:IdentifiedObject.mRID>
    <nc:RemedialAction.kind rdf:resource="http://entsoe.eu/ns/nc#RemedialActionKind.preventive"/>
    <nc:RemedialAction.normalAvailable>true</nc:RemedialAction.normalAvailable>
    <nc:PowerRemedialAction.BiddingZone rdf:resource="http://energy.referencedata.eu/EIC/zone-mo-incomplete-time-point"/>
    <nc:CountertradeRemedialAction.gLSKStrategy rdf:resource="http://entsoe.eu/ns/nc#GLSKStrategyKind.explicitSchedule"/>
    <nc:CountertradeRemedialAction.shiftMethod rdf:resource="http://entsoe.eu/ns/nc#ShiftMethodKind.priority"/>
  </nc:CountertradeRemedialAction>
  <!-- Only up and down are supported: the bids b and c are ignored -->
  <nc:CountertradeRemedialAction rdf:ID="_mo-unsupported-direction">
    <cim:IdentifiedObject.mRID>mo-unsupported-direction</cim:IdentifiedObject.mRID>
    <nc:RemedialAction.kind rdf:resource="http://entsoe.eu/ns/nc#RemedialActionKind.preventive"/>
    <nc:RemedialAction.normalAvailable>true</nc:RemedialAction.normalAvailable>
    <nc:PowerRemedialAction.BiddingZone rdf:resource="http://energy.referencedata.eu/EIC/zone-mo-unsupported-direction"/>
    <nc:CountertradeRemedialAction.gLSKStrategy rdf:resource="http://entsoe.eu/ns/nc#GLSKStrategyKind.explicitSchedule"/>
    <nc:CountertradeRemedialAction.shiftMethod rdf:resource="http://entsoe.eu/ns/nc#ShiftMethodKind.priority"/>
  </nc:CountertradeRemedialAction>
  <!-- The bid b is bound to no resource: it is ignored -->
  <nc:CountertradeRemedialAction rdf:ID="_mo-without-resource">
    <cim:IdentifiedObject.mRID>mo-without-resource</cim:IdentifiedObject.mRID>
    <nc:RemedialAction.kind rdf:resource="http://entsoe.eu/ns/nc#RemedialActionKind.preventive"/>
    <nc:RemedialAction.normalAvailable>true</nc:RemedialAction.normalAvailable>
    <nc:PowerRemedialAction.BiddingZone rdf:resource="http://energy.referencedata.eu/EIC/zone-mo-without-resource"/>
    <nc:CountertradeRemedialAction.gLSKStrategy rdf:resource="http://entsoe.eu/ns/nc#GLSKStrategyKind.explicitSchedule"/>
    <nc:CountertradeRemedialAction.shiftMethod rdf:resource="http://entsoe.eu/ns/nc#ShiftMethodKind.priority"/>
  </nc:CountertradeRemedialAction>
  <!-- The bid b is bound to two resources (two GLSK schedules): it is ignored -->
  <nc:CountertradeRemedialAction rdf:ID="_mo-several-resources">
    <cim:IdentifiedObject.mRID>mo-several-resources</cim:IdentifiedObject.mRID>
    <nc:RemedialAction.kind rdf:resource="http://entsoe.eu/ns/nc#RemedialActionKind.preventive"/>
    <nc:RemedialAction.normalAvailable>true</nc:RemedialAction.normalAvailable>
    <nc:PowerRemedialAction.BiddingZone rdf:resource="http://energy.referencedata.eu/EIC/zone-mo-several-resources"/>
    <nc:CountertradeRemedialAction.gLSKStrategy rdf:resource="http://entsoe.eu/ns/nc#GLSKStrategyKind.explicitSchedule"/>
    <nc:CountertradeRemedialAction.shiftMethod rdf:resource="http://entsoe.eu/ns/nc#ShiftMethodKind.priority"/>
  </nc:CountertradeRemedialAction>
  <!-- The participation factor of the unit of the bid b is 0: it is passed as it is, and the unit is not excluded -->
  <nc:CountertradeRemedialAction rdf:ID="_mo-participation-zero">
    <cim:IdentifiedObject.mRID>mo-participation-zero</cim:IdentifiedObject.mRID>
    <nc:RemedialAction.kind rdf:resource="http://entsoe.eu/ns/nc#RemedialActionKind.preventive"/>
    <nc:RemedialAction.normalAvailable>true</nc:RemedialAction.normalAvailable>
    <nc:PowerRemedialAction.BiddingZone rdf:resource="http://energy.referencedata.eu/EIC/zone-mo-participation-zero"/>
    <nc:CountertradeRemedialAction.gLSKStrategy rdf:resource="http://entsoe.eu/ns/nc#GLSKStrategyKind.explicitSchedule"/>
    <nc:CountertradeRemedialAction.shiftMethod rdf:resource="http://entsoe.eu/ns/nc#ShiftMethodKind.priority"/>
  </nc:CountertradeRemedialAction>
  <!-- The participation factor of the unit of the bid b takes effect at noon: it neither splits the period nor excludes the unit before -->
  <nc:CountertradeRemedialAction rdf:ID="_mo-participation-from-noon">
    <cim:IdentifiedObject.mRID>mo-participation-from-noon</cim:IdentifiedObject.mRID>
    <nc:RemedialAction.kind rdf:resource="http://entsoe.eu/ns/nc#RemedialActionKind.preventive"/>
    <nc:RemedialAction.normalAvailable>true</nc:RemedialAction.normalAvailable>
    <nc:PowerRemedialAction.BiddingZone rdf:resource="http://energy.referencedata.eu/EIC/zone-mo-participation-from-noon"/>
    <nc:CountertradeRemedialAction.gLSKStrategy rdf:resource="http://entsoe.eu/ns/nc#GLSKStrategyKind.explicitSchedule"/>
    <nc:CountertradeRemedialAction.shiftMethod rdf:resource="http://entsoe.eu/ns/nc#ShiftMethodKind.priority"/>
  </nc:CountertradeRemedialAction>
  <!-- Two GLSK schedules with the same mRID are not mixed up: the associations refer to the RDF identifier -->
  <nc:CountertradeRemedialAction rdf:ID="_mo-same-schedule-mrid">
    <cim:IdentifiedObject.mRID>mo-same-schedule-mrid</cim:IdentifiedObject.mRID>
    <nc:RemedialAction.kind rdf:resource="http://entsoe.eu/ns/nc#RemedialActionKind.preventive"/>
    <nc:RemedialAction.normalAvailable>true</nc:RemedialAction.normalAvailable>
    <nc:PowerRemedialAction.BiddingZone rdf:resource="http://energy.referencedata.eu/EIC/zone-mo-same-schedule-mrid"/>
    <nc:CountertradeRemedialAction.gLSKStrategy rdf:resource="http://entsoe.eu/ns/nc#GLSKStrategyKind.explicitSchedule"/>
    <nc:CountertradeRemedialAction.shiftMethod rdf:resource="http://entsoe.eu/ns/nc#ShiftMethodKind.priority"/>
  </nc:CountertradeRemedialAction>
  <!-- A proportional remedial action ignores the bids of the SIS profile (the zone is a real one, as a country is needed to apply a proportional GLSK) -->
  <nc:CountertradeRemedialAction rdf:ID="_mo-proportional-with-bids">
    <cim:IdentifiedObject.mRID>mo-proportional-with-bids</cim:IdentifiedObject.mRID>
    <nc:RemedialAction.kind rdf:resource="http://entsoe.eu/ns/nc#RemedialActionKind.preventive"/>
    <nc:RemedialAction.normalAvailable>true</nc:RemedialAction.normalAvailable>
    <nc:PowerRemedialAction.BiddingZone rdf:resource="http://energy.referencedata.eu/EIC/10YFR-RTE------C"/>
    <nc:CountertradeRemedialAction.gLSKStrategy rdf:resource="http://entsoe.eu/ns/nc#GLSKStrategyKind.proportionalForGenerator"/>
    <nc:CountertradeRemedialAction.shiftMethod rdf:resource="http://entsoe.eu/ns/nc#ShiftMethodKind.shared"/>
  </nc:CountertradeRemedialAction>
  <!-- The only bid of the SIS profile belongs to another remedial action, which is not in the RA profile: no merit order -->
  <nc:CountertradeRemedialAction rdf:ID="_mo-without-own-bids">
    <cim:IdentifiedObject.mRID>mo-without-own-bids</cim:IdentifiedObject.mRID>
    <nc:RemedialAction.kind rdf:resource="http://entsoe.eu/ns/nc#RemedialActionKind.preventive"/>
    <nc:RemedialAction.normalAvailable>true</nc:RemedialAction.normalAvailable>
    <nc:PowerRemedialAction.BiddingZone rdf:resource="http://energy.referencedata.eu/EIC/zone-mo-without-own-bids"/>
    <nc:CountertradeRemedialAction.gLSKStrategy rdf:resource="http://entsoe.eu/ns/nc#GLSKStrategyKind.explicitSchedule"/>
    <nc:CountertradeRemedialAction.shiftMethod rdf:resource="http://entsoe.eu/ns/nc#ShiftMethodKind.priority"/>
  </nc:CountertradeRemedialAction>
  <!-- GEN and GEN2 of the network of the test: scaling the merit order moves them from one limit to the next -->
  <nc:CountertradeRemedialAction rdf:ID="_mo-scalable">
    <cim:IdentifiedObject.mRID>mo-scalable</cim:IdentifiedObject.mRID>
    <nc:RemedialAction.kind rdf:resource="http://entsoe.eu/ns/nc#RemedialActionKind.preventive"/>
    <nc:RemedialAction.normalAvailable>true</nc:RemedialAction.normalAvailable>
    <nc:PowerRemedialAction.BiddingZone rdf:resource="http://energy.referencedata.eu/EIC/zone-mo-scalable"/>
    <nc:CountertradeRemedialAction.gLSKStrategy rdf:resource="http://entsoe.eu/ns/nc#GLSKStrategyKind.explicitSchedule"/>
    <nc:CountertradeRemedialAction.shiftMethod rdf:resource="http://entsoe.eu/ns/nc#ShiftMethodKind.priority"/>
  </nc:CountertradeRemedialAction>
  <!-- The participation factor of the bid changes during the day: the first one is used, and it is reported -->
  <nc:CountertradeRemedialAction rdf:ID="_mo-participation-changes">
    <cim:IdentifiedObject.mRID>mo-participation-changes</cim:IdentifiedObject.mRID>
    <nc:RemedialAction.kind rdf:resource="http://entsoe.eu/ns/nc#RemedialActionKind.preventive"/>
    <nc:RemedialAction.normalAvailable>true</nc:RemedialAction.normalAvailable>
    <nc:PowerRemedialAction.BiddingZone rdf:resource="http://energy.referencedata.eu/EIC/zone-mo-participation-changes"/>
    <nc:CountertradeRemedialAction.gLSKStrategy rdf:resource="http://entsoe.eu/ns/nc#GLSKStrategyKind.explicitSchedule"/>
    <nc:CountertradeRemedialAction.shiftMethod rdf:resource="http://entsoe.eu/ns/nc#ShiftMethodKind.priority"/>
  </nc:CountertradeRemedialAction>
  <!-- The resource of the bid has no participation factor: the bid is kept, with a factor of 1 -->
  <nc:CountertradeRemedialAction rdf:ID="_mo-participation-missing">
    <cim:IdentifiedObject.mRID>mo-participation-missing</cim:IdentifiedObject.mRID>
    <nc:RemedialAction.kind rdf:resource="http://entsoe.eu/ns/nc#RemedialActionKind.preventive"/>
    <nc:RemedialAction.normalAvailable>true</nc:RemedialAction.normalAvailable>
    <nc:PowerRemedialAction.BiddingZone rdf:resource="http://energy.referencedata.eu/EIC/zone-mo-participation-missing"/>
    <nc:CountertradeRemedialAction.gLSKStrategy rdf:resource="http://entsoe.eu/ns/nc#GLSKStrategyKind.explicitSchedule"/>
    <nc:CountertradeRemedialAction.shiftMethod rdf:resource="http://entsoe.eu/ns/nc#ShiftMethodKind.priority"/>
  </nc:CountertradeRemedialAction>
</rdf:RDF>
